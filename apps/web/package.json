{
  "name": "@sacute/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/generate-favicon.mjs && react-router dev --host 127.0.0.1",
    "build": "pnpm --filter @sacute/shared build && node scripts/generate-favicon.mjs && react-router build && node scripts/generate-seo.mjs",
    "preview": "node scripts/preview.mjs",
    "typecheck": "react-router typegen && tsc --noEmit"
  },
  "dependencies": {
    "@react-router/express": "7.18.5",
    "@react-router/node": "7.18.5",
    "@sacute/shared": "workspace:*",
    "@vercel/react-router": "^1.3.7",
    "express": "^5.3.0",
    "isbot": "^5.1.31",
    "lucide-react": "^1.64.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "7.18.5"
  },
  "devDependencies": {
    "@react-router/dev": "7.18.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.3.3",
    "vite": "^7.3.7"
  }
}
