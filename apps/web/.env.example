# Server runtime only. Never prefix these with VITE_. No privileged key is needed.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Browser-safe SEO settings. Use the production origin for canonical URLs.
VITE_SITE_ORIGIN=https://sacute.vercel.app
# Set true only on the production deployment after indexing is approved.
VITE_ALLOW_INDEXING=false

# Private CMS, server runtime only. Keep false until audit + ALL THREE reviewed migrations (001, 002, 003).
# The independent admin_cms_settings database gate must also remain false.
ADMIN_WRITES_ENABLED=false
# Production: set the exact HTTPS origin, e.g. https://sacute.vercel.app
# No trailing slash. Blank uses the request origin for local development.
ADMIN_ORIGIN=
