# Copy apps/web/.env.example and apps/api/.env.example to the matching .env files.
# The build needs no production credentials.
# Runtime public content reads require SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY.

# Private CMS, server runtime only. Keep false until audit + ALL THREE reviewed migrations (001, 002, 003).
# The independent admin_cms_settings database gate must also remain false.
ADMIN_WRITES_ENABLED=false
# Production: set the exact HTTPS origin, e.g. https://sacute.vercel.app
# No trailing slash. Blank uses the request origin for local development.
ADMIN_ORIGIN=
